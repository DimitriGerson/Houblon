#!/usr/bin/env python3
import sqlite3
import paho.mqtt.client as mqtt
from datetime import date
import os

# ================== CONFIGURATION ==================
MQTT_USER = "mqttuser"
MQTT_PASSWORD = "dimgers"
MQTT_BROKER = "192.168.1.159"      # IP ou hostname du broker
MQTT_PORT = 1883
MQTT_TOPIC = "maison/+/+/+"

BASE_DIR = "/home/pi/mqtt_sqlite/data"
os.makedirs(BASE_DIR, exist_ok=True)
# ===================================================


def open_db_for_today():
    today = date.today().isoformat()
    os.makedirs(BASE_DIR, exist_ok=True)
    db_path = os.path.join(BASE_DIR, "mesures_{}.db".format(today))

    conn = sqlite3.connect(db_path, check_same_thread=False)
    cursor = conn.cursor()

    cursor.execute("""
    CREATE TABLE IF NOT EXISTS mesures (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
       maison TEXT,
        etage TEXT,
        chambre TEXT,
        type TEXT,
        valeur TEXT,
        timestamp DATETIME DEFAULT CURRENT_TIMESTAMP
    )
    """)

    conn.commit()
    return conn, cursor, today


# --- Initialisation ---
conn, cursor, current_day = open_db_for_today()


# ================== MQTT CALLBACKS ==================
def on_connect(client, userdata, flags, rc):
    print("Connecté au broker MQTT")
    client.subscribe(MQTT_TOPIC, qos=0)


def on_message(client, userdata, msg):
    global conn, cursor, current_day

    #changement de jour automatique
    today = date.today().isoformat()
    if today != current_day:
        print("Nouveau jour → nouvelle base")
        conn.close()
        conn, cursor, current_day = open_db_for_today()

    try:
        payload = msg.payload.decode().strip()
        print("Message reçu")
        maison, etage, chambre, mesure_type = msg.topic.split("/")

        cursor.execute(
            "INSERT INTO mesures (maison, etage, chambre, type, valeur) VALUES (?, ?, ?, ?, ?)",
            (maison, etage, chambre, mesure_type, payload)
        )
        conn.commit()

        print("{}= {}".format(msg.topic, payload))

    except Exception as e:
        print("Erreur:", e)


# ================== LANCEMENT ==================
client = mqtt.Client()
client.username_pw_set(MQTT_USER, MQTT_PASSWORD)
client.on_connect = on_connect
client.on_message = on_message

client.connect(MQTT_BROKER, MQTT_PORT, 60)
client.loop_forever()
